{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://sales.test/api/v1",
        "EXPO_PUBLIC_DEVICE_NAME": "Permana Mobile (dev build)"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.sales.permana.net.id/api/v1",
        "EXPO_PUBLIC_DEVICE_NAME": "Permana Mobile (preview)"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://sales.permana.net.id/api/v1",
        "EXPO_PUBLIC_DEVICE_NAME": "Permana Mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
