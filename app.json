{
  "expo": {
    "name": "Permana Sales",
    "slug": "permana-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "permana",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.permana.sales",
      "infoPlist": {
        "NSCameraUsageDescription": "Selfie photos for attendance check-in and canvassing photos.",
        "NSLocationWhenInUseUsageDescription": "Tags your location for check-in and field visits."
      }
    },
    "android": {
      "package": "id.permana.sales",
      "adaptiveIcon": {
        "backgroundColor": "#034A6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tags your location for check-in and field visits."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Selfie photos for attendance check-in and canvassing photos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#034A6B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "pt-medianusa-permana",
    "extra": {
      "eas": {
        "projectId": "dbb348d5-6249-4548-a8a9-9e0d22288906"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/dbb348d5-6249-4548-a8a9-9e0d22288906"
    }
  }
}
